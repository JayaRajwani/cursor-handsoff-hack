# =====================================================================
#  MedAI Academy — environment variables
#  1. Copy this file to ".env.local"  (cp .env.example .env.local)
#  2. Fill in the values below.
#  3. Add the SAME variables in Vercel → Project → Settings → Environment Variables.
#  NEVER commit .env.local to GitHub (it is already in .gitignore).
#  Variables starting with NEXT_PUBLIC_ are visible in the browser — that is
#  fine for those below. All others are SECRET and stay on the server.
# =====================================================================

# ---------- Website address ----------
# Local development: http://localhost:3000
# Production: your live address, e.g. https://medaiacademy.vercel.app or https://www.yourdomain.com
# Used for SEO (canonical URLs, sitemap), emails and certificates.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (database, login, file storage) ----------
# Supabase dashboard → your project → Project Settings → API (or "API Keys")
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public key: the "Publishable key" (starts with sb_publishable_) — or the legacy "anon" key.
# Safe to expose; Row Level Security protects your data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (Legacy name also supported: NEXT_PUBLIC_SUPABASE_ANON_KEY)

# SECRET key: the "Secret key" (starts with sb_secret_) — or the legacy "service_role" key.
# ⚠️ Full access to your database. Server only. Never share it or prefix it with NEXT_PUBLIC_.
# Used to save public form submissions, issue certificates and enrol users in free courses.
SUPABASE_SECRET_KEY=
# (Legacy name also supported: SUPABASE_SERVICE_ROLE_KEY)

# ---------- Resend (emails) ----------
# https://resend.com → API Keys → Create API Key (free plan: 3,000 emails/month)
# If empty, emails are not sent (they are printed in the terminal instead).
RESEND_API_KEY=

# The "From" address. Until you verify your own domain in Resend, use:
#   MedAI Academy <onboarding@resend.dev>   (can only send to your own Resend account email)
# After verifying your domain:  MedAI Academy <hello@yourdomain.com>
EMAIL_FROM=MedAI Academy <onboarding@resend.dev>

# Your email address — receives notifications about new payments, contact messages
# and institution enquiries.
ADMIN_EMAIL=

# ---------- Cal.com booking (optional) ----------
# Your public Cal.com event link, shown on the "Book a session" page.
# Can also be set in src/config/site.ts.
NEXT_PUBLIC_CAL_LINK=https://cal.com/your-username/consultation
